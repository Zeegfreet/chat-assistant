{
  "name": "auth-server",
  "version": "1.0.0",
  "description": "Api de autenticação para o sistema hermes. ",
  "keywords": [
    "WFSA"
  ],
  "license": "ISC",
  "author": "Wesley Arruda",
  "main": "server.js",
  "scripts": {
    "build": "tsc && tsc-alias && cpy \"src/app/docs/**/*\" dist/app/docs",
    "dev": "ts-node-dev --watch src/**/*.yaml -r tsconfig-paths/register --respawn --transpile-only ./src/server.ts",
    "test": "jest --verbose",
    "test:watch": "jest --verbose --watch",
    "test:hasher": "jest --verbose ./__tests__/infra/hasher/passwordHasher.test.ts",
    "migration:generate": "ts-node ./node_modules/typeorm/cli.js migration:generate ./src/infra/db/migrations/startSchema -d ./src/app/config/migrationConfig.ts",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d ./src/app/config/migrationConfig.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d ./src/app/config/migrationConfig.ts",
    "schema:sync": "ts-node ./node_modules/typeorm/cli.js schema:sync -d ./src/app/config/migrationConfig.ts",
    "db:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs db:create -d ./src/app/config/migrationConfig.ts",
    "db:drop": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs db:drop -d ./src/app/config/migrationConfig.ts",
    "seed:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d ./src/app/config/migrationConfig.ts",
    "seed:create": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:create --name src/infra/db/seeds/$SEED",
    "test:jwt": "jest --verbose ./__tests__/infra/hasher/jwtAdapters.test.ts",
    "test:jwt:simetric": "jest --verbose ./__tests__/infra/cryptography/jwtSimetricEncrypterAdapter.test.ts",
    "test:jwk:adapter": "jest --verbose ./__tests__/infra/cryptography/cryptoJwkGenerator.test.ts",
    "test:adapters:validation:composite": "jest --verbose ./__tests__/presentation/validation/validationComposite.test.ts",
    "test:adapters:validation:zod": "jest --verbose ./__tests__/presentation/validation/zodValidator.test.ts",
    "test:user:integration": "jest --verbose ./__tests__/integrations/usersRoutes.test.ts",
    "test:user:repository": "jest --verbose ./__tests__/infra/db/repositorys/userRepositoryORM.test.ts",
    "test:user:add:usecase": "jest --verbose ./__tests__/data/useCase/user/dbAddUser.test.ts",
    "test:user:add:controller": "jest --verbose ./__tests__/presentation/controllers/addUserController.test.ts",
    "test:user:add:repository": "jest --verbose ./__tests__/infra/db/repositorys/user/typeOrmAddUserRepository.test.ts",
    "test:user:add:integration": "jest --verbose ./__tests__/integrations/user/addUserRoutes.test.ts",
    "test:user:delete:usecase": "jest --verbose ./__tests__/data/useCase/user/dbDeleteUser.test.ts",
    "test:user:delete:controller": "jest --verbose ./__tests__/presentation/controllers/deleteUserController.test.ts",
    "test:user:delete:repository": "jest --verbose ./__tests__/infra/db/repositorys/typeOrmDeleteUserRepository.test.ts",
    "test:user:delete:integration": "jest --verbose ./__tests__/integrations/user/deleteUserRoutes.test.ts",
    "test:user:update:usecase": "jest --verbose ./__tests__/data/useCase/user/dbUpdateUser.test.ts",
    "test:user:update:dtomapper": "jest --verbose ./__tests__/presentation/mappers/dtos/updateUserDtoMapper.test.ts",
    "test:user:update:controller": "jest --verbose ./__tests__/presentation/controllers/updateUserController.test.ts",
    "test:user:update:integration": "jest --verbose ./__tests__/integrations/user/updateUserRoutes.test.ts",
    "test:user:list:usecase": "jest --verbose ./__tests__/data/useCase/user/dbListUsers.test.ts",
    "test:user:list:controller": "jest --verbose ./__tests__/presentation/controllers/listUserController.test.ts",
    "test:user:findbypk:usecase": "jest --verbose ./__tests__/data/useCase/user/dbFindUserByPk.test.ts",
    "test:user:findbypk:controller": "jest --verbose ./__tests__/presentation/controllers/findUserByPkController.test.ts",
    "test:user:findbyemail:repository": "jest --verbose ./__tests__/infra/db/repositorys/typeOrmFindUserByEmailRepository.test.ts",
    "test:user:findbypk:repository": "jest --verbose ./__tests__/infra/db/repositorys/user/typeOrmFindUserByPkRepository.test.ts",
    "test:user:findbypk:integration": "jest --verbose ./__tests__/integrations/user/findByPkRoutes.test.ts",
    "test:user:list:repository": "jest --verbose ./__tests__/infra/db/repositorys/typeOrmListUsersRepository.test.ts",
    "test:user:update:repository": "jest --verbose ./__tests__/infra/db/repositorys/user/typeOrmUpdateUserRepository.test.ts",
    "test:user:search:integration": "jest --verbose auth-server/__tests__/integrations/user/searchUserRoutes.test.ts",
    "test:signin:usecase": "jest --verbose ./__tests__/data/useCase/auth/dbSignIn.test.ts",
    "test:signin:integration": "jest --verbose --detectOpenHandles ./__tests__/integrations/signInRoutes.test.ts",
    "test:signup:usecase": "jest --verbose ./__tests__/data/useCase/auth/dbSignUp.test.ts",
    "test:signup:integration": "jest --verbose --detectOpenHandles ./__tests__/integrations/signUpRoutes.test.ts",
    "test:user:confirm:repository": "jest --verbose ./__tests__/infra/db/repositorys/user/typeOrmConfirmUserExistenceByEmailRepository.test.ts",
    "test:user:loadauth:repository": "jest --verbose ./__tests__/infra/db/repositorys/user/typeOrmLoadAuthuserByEmailRepository.test.ts",
    "test:permission:add:repository": "jest --verbose ./__tests__/infra/db/repositorys/permission/typeOrmAddPermissionRepository.test.ts",
    "test:permission:add:usecase": "jest --verbose ./__tests__/data/useCase/permission/addPermission.test.ts",
    "test:permission:add:integration": "jest --verbose ./__tests__/integrations/permission/addPermissionRoute.test.ts",
    "test:permission:list:repository": "jest --verbose ./__tests__/infra/db/repositorys/permission/typeOrmListPermissionRepository.test.ts",
    "test:permission:delete:integration": "jest --verbose ./__tests__/integrations/permission/deletePermissionRoute.test.ts",
    "test:permission:delete:repository": "jest --verbose ./__tests__/infra/db/repositorys/permission/typeOrmDeletePermissionRepository.test.ts",
    "test:permission:findbypk:integration": "jest --verbose ./__tests__/integrations/permission/findPermissionByPkRoute.test.ts",
    "test:permission:update:integration": "jest --verbose ./__tests__/integrations/permission/updatePermissionRoute.test.ts",
    "test:permission:list:integration": "jest --verbose ./__tests__/integrations/permission/listPermissionRoute.test.ts",
    "test:permission:massdelete:repository": "jest --verbose ./__tests__/infra/db/repositorys/permission/typeOrmMassDeletePermissionRepository.test.ts",
    "test:permission:massdelete:integration": "jest --verbose ./__tests__/integrations/permission/massDeletePermissionRoute.test.ts",
    "test:role:add:repository": "jest --verbose ./__tests__/infra/db/repositorys/role/typeOrmAddRoleRepository.test.ts",
    "test:role:add:integration": "jest --verbose ./__tests__/integrations/role/addRoleRoutes.test.ts",
    "test:role:delete:integration": "jest --verbose ./__tests__/integrations/role/deleteRoleRoutes.test.ts",
    "test:role:findbypk:integration": "jest --verbose ./__tests__/integrations/role/findRoleByPkRoutes.test.ts",
    "test:role:search:integration": "jest --verbose ./__tests__/integrations/role/searchRoleRoutes.test.ts",
    "test:role:update:integration": "jest --verbose ./__tests__/integrations/role/updateRoleRoutes.test.ts",
    "test:role:update:repository": "jest --verbose ./__tests__/infra/db/repositorys/session/typeOrmAddSessionRepository.test.ts",
    "test:profile:find:integration": "jest --verbose ./__tests__/integrations/profile/getProfile.test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@google/genai": "^1.46.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.1",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "cookieparser": "^0.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/chalk": "^0.4.31",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.10",
    "@types/pino": "^7.0.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cpy-cli": "^6.0.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "query-string": "^9.3.1",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
